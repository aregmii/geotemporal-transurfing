[["Operation Morvarid: operation launched by the Iranian Navy and Air Force…",26,52,1980,1980,"con",2,"Persian Gulf","Operation Morvarid was an operation launched by the Iranian Navy and Air Force against the Iraqi Navy sites on 27 November 1980 in response to Iraq positioning radar and monitoring equipment on the Mina Al-Bakr and Khor-al-Amaya oil rigs to counter Iranian air operations. The operation resulted in a victory for Iran, which managed to destroy both oil rigs as well as much of the Iraqi Navy and inflicted significant damage to Iraqi ports and airfields.","Operation_Morvarid","1980-11-29",null,null,"Operation Morvarid",{"id":"evt-h4bbze-1qqzlzw","sourceIdentity":"dated|Operation_Morvarid|Operation Morvarid|1980-11-29|26|52","mediaKey":"Operation_Morvarid|1980-11-29|26|52","source":{"type":"dated","file":"events_wikidata.json","url":"https://en.wikipedia.org/wiki/Operation_Morvarid"},"kind":"point","start":{"iso":"1980-11-29","precision":"day","source":{"type":"dated","file":"events_wikidata.json","url":"https://en.wikipedia.org/wiki/Operation_Morvarid"}},"end":null}],["1980 NBA Draft",39.83,-98.58,1980,1980,"cul",2,"","basketball player selection","1980_NBA_draft","1980-06-10",null,null,"1980 NBA Draft",{"id":"evt-1xc3n4m-1sspym4","sourceIdentity":"dated|1980_NBA_draft|1980 NBA Draft|1980-06-10|39.83|-98.58","mediaKey":"1980_NBA_draft|1980-06-10|39.83|-98.58","source":{"type":"dated","file":"events_wikidata.json","url":"https://en.wikipedia.org/wiki/1980_NBA_draft"},"kind":"point","start":{"iso":"1980-06-10","precision":"day","source":{"type":"dated","file":"events_wikidata.json","url":"https://en.wikipedia.org/wiki/1980_NBA_draft"}},"end":null}],["1980 Japanese general election",35,136,1980,1980,"con",2,"","general election in Japan held in 1980","1980_Japanese_general_election","1980-06-22",null,null,"1980 Japanese general election",{"id":"evt-mhqs0m-fz47ko","sourceIdentity":"dated|1980_Japanese_general_election|1980 Japanese general election|1980-06-2