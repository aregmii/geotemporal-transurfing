[["1960 Ethiopian coup attempt: attempted against Emperor Haile Selassie of Ethiopia",9.04,38.75,1960,1960,"con",2,"Addis Ababa","A coup d'état was attempted against Emperor Haile Selassie of Ethiopia on 13 December 1960 by the Council of the Revolution, a cabal of four conspirators led by brothers Germame Neway and Brigadier General Mengistu Neway, commander of the Kebur Zabagna. They sought to overthrow the emperor during a state visit to Brazil in order to install a progressive government.","1960_Ethiopian_coup_attempt","1960-12-13",null,null,"1960 Ethiopian coup attempt",{"id":"evt-1w6z071-vh654n","sourceIdentity":"dated|1960_Ethiopian_coup_attempt|1960 Ethiopian coup attempt|1960-12-13|9.04|38.75","mediaKey":"1960_Ethiopian_coup_attempt|1960-12-13|9.04|38.75","source":{"type":"dated","file":"events_wikidata.json","url":"https://en.wikipedia.org/wiki/1960_Ethiopian_coup_attempt"},"kind":"point","start":{"iso":"1960-12-13","precision":"day","source":{"type":"dated","file":"events_wikidata.json","url":"https://en.wikipedia.org/wiki/1960_Ethiopian_coup_attempt"}},"end":null}],["Scandinavian Airlines System Flight 871 — 1960 aviation accident",39,36,1960,1960,"dis",2,"","1960 aviation accident","Scandinavian_Airlines_System_Flight_871","1960-01-19",null,null,"Scandinavian Airlines System Flight 871",{"id":"evt-ngm6kh-f772nv","sourceIdentity":"dated|Scandinavian_Airlines_System_Flight_871|Scandinavian Airlines System Flight 871|1960-01-19|39|36","mediaKey":"Scandinavian_Airlines_System_Flight_871|1960-01-19|39|36","source":{"type":"dated","file":"events_wikidata.json","url":"https://en.wikipedia.org/wiki/Scandinavian_Airlines_System_Flight_871"},"kind":"point","start":{"iso":"1960-01-19","precision":"day","source":{"type":"dated","file":"events_wikidata.json","url":"https://en.wikipedia.org/wiki/Scandinavian_Airlines_System_Flight_871"}},"end":null}],["Cuba–North Korea relations",40,127,1960,1960,"cul",2,"","diplomatic relations between Cuba and North Korea","Cuba%E2